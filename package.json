{
  "name": "shadowform.net",
  "version": "1.0.0",
  "description": "Website for shadowform.net",
  "homepage": "https://github.com/zyshara/shadowform.net#readme",
  "bugs": {
    "url": "https://github.com/zyshara/shadowform.net/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zyshara/shadowform.net.git"
  },
  "license": "ISC",
  "author": "Jennifer Decker (@zyshara)",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=22.22.0"
  },
  "imports": {
    "#lib/*": "./server/lib/*",
    "#models/*": "./server/models/*",
    "#automation/*": "./server/automation/*",
    "#auth/*": "./server/auth/*",
    "#middleware/*": "./server/middleware/*",
    "#routes/*": "./server/routes/*",
    "#cron/*": "./server/cron/*",
    "#apps/domeofdoom/*": "./server/apps/domeofdoom/*",
    "#apps/shadowform/*": "./server/apps/shadowform/*",
    "#apps/redspear/*": "./server/apps/redspear/*",
    "#apps/low-poly/*": "./server/apps/low-poly/*"
  },
  "scripts": {
    "build": "npm run build:ssr && node scripts/generate-sitemap.mjs",
    "clean": "node scripts/clean-build.mjs",
    "build:ssr": "npm run clean && react-router build src/redspear && react-router build src/low-poly && react-router build src/domeofdoom && react-router build src/shadowform",
    "start": "node server.js",
    "dev": "nodemon --exec \"node --conditions=development\" server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@notionhq/client": "^5.23.2",
    "@remix-run/node-fetch-server": "^0.14.2",
    "atrament": "^5.1.0",
    "compression": "^1.8.2",
    "dod-bandcamp-scraper": "github:zyshara/dod-bandcamp-scraper#main",
    "dotenv": "^17.4.0",
    "express": "^5.1.0",
    "framer-motion": "^12.23.26",
    "googleapis": "^173.0.0",
    "isbot": "^5",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.12",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "autoprefixer": "^10.4.21",
    "jsdom": "^24.1.3",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.13",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
